#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"

abort "usage: bin/stamp-version VERSION FILE" unless ARGV.size == 2
version, path = ARGV

unless Gem::Version.correct?(version) && Gem::Version.new(version).to_s == version
  abort "not a releasable version: #{version.inspect}"
end

pattern = /^(\s*VERSION = )"[^"]*"$/
source = File.read(path)
matches = source.scan(pattern).size
abort "expected one VERSION literal in #{path}, found #{matches}" unless matches == 1

File.write(path, source.sub(pattern) { "#{$1}\"#{version}\"" })

# The text match cannot tell a comment, a suffix or a later reassignment from
# the real constant, so the stamped file is loaded and the constant read back.
# RubyGems stays enabled because `gem build` loads the file with it.
verified = false
begin
  loaded, status = Open3.capture2(
    { "RUBYOPT" => nil, "BUNDLE_GEMFILE" => nil }, RbConfig.ruby, "-e",
    "load ARGV[0]; print OpenTelemetry::Instrumentation::SQLite3::VERSION", File.expand_path(path),
    err: File::NULL
  )
  verified = status.success? && loaded == version
ensure
  File.write(path, source) unless verified
end
abort "#{path} does not load as VERSION #{version.inspect} once stamped" unless verified
